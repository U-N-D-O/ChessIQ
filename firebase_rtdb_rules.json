{
    "rules": {
        ".read": false,
        ".write": false,
        "academy_scoreboard": {
            ".read": true,
            ".write": false,
            "global": {
                ".indexOn": [
                    "score"
                ],
                "$handleKey": {
                    ".write": "auth != null && !newData.exists() && root.child('academy_profile_owner/' + auth.uid + '/handleKey').val() == $handleKey"
                }
            },
            "by_country": {
                "$country": {
                    ".indexOn": [
                        "score"
                    ],
                    "$handleKey": {
                        ".write": "auth != null && !newData.exists() && root.child('academy_profile_owner/' + auth.uid + '/handleKey').val() == $handleKey && root.child('academy_profile_owner/' + auth.uid + '/countryKey').val() == $country"
                    }
                }
            }
        },
        "academy_profile_owner": {
            "$uid": {
                ".read": "auth != null && auth.uid == $uid",
                ".write": "auth != null && auth.uid == $uid && !newData.exists()"
            }
        },
        "handle_registry": {
            ".read": false,
            "$handleKey": {
                ".write": "auth != null && !newData.exists() && data.val() == auth.uid"
            }
        },
        "promo_codes": {
            ".read": false,
            ".write": false
        },
        "promo_code_claims": {
            "$uid": {
                ".read": "auth != null && auth.uid == $uid",
                ".write": false
            }
        },
        "storefront_public": {
            ".read": true,
            ".write": false
        },
        "daily_challenges_public": {
            ".read": true,
            ".write": false
        },
        "friend_matches": {
            "$matchId": {
                ".read": "auth != null && root.child('friend_match_memberships/' + auth.uid + '/' + $matchId).exists()",
                ".write": false
            }
        },
        "friend_match_invites": {
            ".read": false,
            ".write": false,
            "by_code": {
                "$inviteCode": {
                    ".read": false,
                    ".write": false
                }
            }
        },
        "friend_match_memberships": {
            "$uid": {
                ".read": "auth != null && auth.uid == $uid",
                ".write": false,
                "$matchId": {
                    ".write": false
                }
            }
        }
    }
}