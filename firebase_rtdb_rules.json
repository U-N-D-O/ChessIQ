{
    "rules": {
        ".read": false,
        ".write": false,
        "academy_scoreboard": {
            ".read": true,
            ".write": false,
            "global": {
                ".indexOn": [
                    "score"
                ],
                "$handleKey": {
                    ".write": "auth != null && !newData.exists() && root.child('academy_profile_owner/' + auth.uid + '/handleKey').val() == $handleKey"
                }
            },
            "by_country": {
                "$country": {
                    ".indexOn": [
                        "score"
                    ],
                    "$handleKey": {
                        ".write": "auth != null && !newData.exists() && root.child('academy_profile_owner/' + auth.uid + '/handleKey').val() == $handleKey && root.child('academy_profile_owner/' + auth.uid + '/countryKey').val() == $country"
                    }
                }
            }
        },
        "academy_profile_owner": {
            "$uid": {
                ".read": "auth != null && auth.uid == $uid",
                ".write": "auth != null && auth.uid == $uid && !newData.exists()"
            }
        },
        "handle_registry": {
            ".read": false,
            "$handleKey": {
                ".write": "auth != null && !newData.exists() && data.val() == auth.uid"
            }
        }
    }
}